    "region": "universal",
    "era_bounds": [
      "2018",
      null
    ],
    "still_effective_2026": true,
    "confidence": "primary",
    "citations": [
      "hashcat-modes"
    ],
    "technical_body": {
      "note": "22000 is a slow hash (PBKDF2-HMAC-SHA1 with 4096 iterations). Modern RTX 4090 hits ~2 MH/s. rockyou.txt (~14M words) crackable in seconds; 12-char alnum mask is at the wall-time barrier.",
      "example_command": "hashcat -m 22000 -a 0 hs.22000 rockyou.txt -w 4 --status --status-timer=30"
    }
