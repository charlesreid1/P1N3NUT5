    "technical_body": {
      "mode": 22000,
      "capture_format": "hccapx-superseded; one line per PMKID+EAPOL hash",
      "producer": "hcxpcapngtool from hcxtools",
      "handles": [
        "PMKID (M1-only)",
        "4-way handshake (any subset containing an M2)"
