      "example_line": "WPA*01*<PMKID>*<AP MAC>*<Client MAC>*<ESSID hex>***",
      "example_command": "hashcat -m 22000 hashes.22000 rockyou.txt -w 4 --status",
      "producer_tool": "hcxpcapngtool from hcxtools"
    }
