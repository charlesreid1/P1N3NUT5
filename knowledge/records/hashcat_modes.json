  {
    "id": "hashcat-mode-5500",
    "name": "hashcat mode 5500 \u2014 NetNTLMv1 / MSCHAPv2 / LEAP",
    "aliases": [
      "5500",
      "netntlmv1",
      "mschapv2",
      "leap",
      "cisco-leap"
    ],
    "category": "hashcat_mode",
