      null
    ],
    "still_effective_2026": true,
    "confidence": "primary",
    "citations": [
      "hashcat-modes",
      "rfc-2759",
      "wright-asleap"
    ],
    "technical_body": {
      "mode": 5500,
      "note": "MSCHAPv2 challenge-response captured from PEAP / EAP-TTLS inner exchanges via hostapd-wpe or eaphammer. Also the correct mode for **legacy Cisco LEAP** \u2014 LEAP uses MSCHAPv2 internally, so its challenge-response has the same NetNTLMv1 shape. asleap is the classic offline cracker for both.",
      "aliases_note": "LEAP goes here, not in mode 4800.",
      "example_command": "hashcat -m 5500 mschapv2.txt rockyou.txt -w 4 -r rules/best64.rule"
    }
  },
