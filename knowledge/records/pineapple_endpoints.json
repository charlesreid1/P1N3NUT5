  {
    "id": "pep-list-aps",
    "name": "list_aps — enumerate APs from recon DB",
    "category": "pineapple_endpoint",
    "region": "universal",
    "era_bounds": ["2020", null],
    "still_effective_2026": true,
    "confidence": "primary",
    "citations": ["hak5-mk7-docs"],
    "capability": "list_aps",
    "transports": ["api", "ssh"],
    "primary": "api",
    "api": {
      "method": "GET",
      "path": "/api/recon/ap",
      "auth_scope": "recon.read",
      "response_shape": "array of {bssid, ssid, channel, rssi, security, last_seen, ies?}"
    },
    "ssh": {
      "cmd": "iw dev wlan1 scan | awk -f /root/parse_scan.awk",
      "requires_root": true,
      "requires_monitor": false,
      "fallback_for": "recon service disabled",
      "warning": "SSH path returns only the current-moment scan, not the accumulated recon DB"
    },
    "firmware_min": "3.0.0",
    "firmware_max": null,
    "notes": "Prefer API. SSH path is real-time-only; WebUI's cached DB has more history."
  },
