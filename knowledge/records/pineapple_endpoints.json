  {
    "id": "pep-capture-pmkid",
    "name": "capture_pmkid \u2014 hcxdumptool PMKID capture",
    "category": "pineapple_endpoint",
    "region": "universal",
    "era_bounds": [
      "2018",
      null
    ],
    "still_effective_2026": true,
    "confidence": "primary",
    "citations": [
      "hcxtools",
      "steube-pmkid-2018"
    ],
    "see_also": [
      "pmkid-capture"
    ],
    "capability": "capture_pmkid",
    "transports": [
      "ssh"
    ],
    "primary": "ssh",
    "ssh": {
      "cmd": "hcxdumptool -i <iface> -w <out.pcapng> --enable_status=3 [--bpf=<compiled_bpf>]",
      "requires_root": true,
      "requires_monitor": false,
      "notes": "hcxdumptool 7.3 CLI: -w (not -o); --bpf=<compiled_bpf> replaces --filterlist_ap/--filtermode. hcxdumptool manages monitor mode itself; do not pre-set with airmon-ng. Active deauth was removed in 6.x \u2014 pair with mdk4/aireplay-ng if a reassoc is needed."
    },
    "firmware_min": "3.0.0",
    "firmware_max": null
  },
