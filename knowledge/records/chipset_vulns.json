    "id": "chipset-driver-inject-matrix",
    "name": "Driver monitor+injection support matrix (2026)",
    "category": "chipset_vuln",
    "region": "universal",
    "era_bounds": ["2020", null],
    "still_effective_2026": true,
    "confidence": "primary",
    "citations": ["aircrack-ng-docs"],
    "technical_body": {
      "role": "attacker (Pineapple + external USB adapters)",
      "matrix": {
        "ath9k": "monitor + injection reliable; the reference",
        "ath10k": "monitor OK; injection firmware-limited",
        "ath11k": "Wi-Fi 6E capable; injection support improving",
        "mt76": "monitor + injection OK on recent kernels; MediaTek",
        "rtl8812au (Realtek)": "monitor + injection working with aircrack-ng fork; unreliable on some frames",
        "rtl88x2bu": "monitor OK; injection unreliable",
        "iwlwifi (Intel)": "monitor limited; injection generally unsupported on many revs",
        "brcmfmac (Broadcom)": "monitor limited; injection generally unsupported"
      },
      "recommended_pineapple_external": ["Alfa AWUS036ACHM (mt76)", "Alfa AWUS036AXML (mt76-ax)", "Alfa AWUS036NHA (ath9k)"]
    }
