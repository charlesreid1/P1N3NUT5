  {
    "id": "ie-rsn",
    "name": "Robust Security Network / RSN IE (IE 48)",
    "aliases": ["rsn ie", "rsne"],
    "category": "information_element",
    "region": "universal",
    "era_bounds": ["2004", null],
    "still_effective_2026": true,
    "confidence": "primary",
    "citations": ["ieee-802-11-2020"],
    "technical_body": {
      "element_id": 48,
      "fields": [
        "Version (=1)",
        "Group Cipher Suite (OUI 00-0F-AC:x)",
        "Pairwise Cipher Suite Count + list",
        "AKM Suite Count + list",
        "RSN Capabilities (MFPR/MFPC bits, PMF, replay counters)",
        "PMKID Count + list (M1 or reassoc)",
        "Group Management Cipher Suite (for PMF)"
      ],
      "cipher_suites": {
        "1": "WEP-40",
        "2": "TKIP",
        "4": "CCMP-128",
        "5": "WEP-104",
        "8": "GCMP-128",
        "9": "GCMP-256",
        "6": "BIP-CMAC-128 (group mgmt)"
      },
      "akm_suites": {
        "1": "802.1X (Enterprise, PMKSA cache)",
        "2": "PSK",
        "3": "FT-802.1X",
        "4": "FT-PSK",
        "5": "802.1X-SHA256",
        "6": "PSK-SHA256",
        "8": "SAE",
        "9": "FT-SAE",
        "11": "Suite B 192-bit",
        "12": "OWE",
        "18": "SAE-EXT-KEY (H2E)"
      },
      "wctf_uses": [
        "beacon-RSN inspection is the first-60-seconds triage",
        "AKM 2 + AKM 8 both present = WPA3 transition mode = downgrade opportunity",
        "PMKID present in M1 = client-free crack path (Steube 2018)"
      ]
    }
  },
