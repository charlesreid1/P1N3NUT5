  {
    "id": "uci-encryption-strings",
    "name": "wifi-iface encryption string enumeration",
    "category": "openwrt_uci",
    "region": "universal",
    "era_bounds": [
      "2018",
      null
    ],
    "still_effective_2026": true,
    "confidence": "primary",
    "citations": [
      "openwrt-uci-docs"
    ],
    "technical_body": {
      "section": "wireless.@wifi-iface[N]",
      "option": "encryption",
      "recognized_values": {
        "none": "open, no encryption",
        "psk2": "WPA2-PSK with CCMP",
        "psk2+ccmp": "WPA2-PSK with CCMP explicit",
        "psk-mixed": "WPA1+WPA2 PSK transition (both TKIP and CCMP advertised)",
        "sae": "WPA3-SAE only",
        "sae-mixed": "WPA2-PSK + WPA3-SAE transition \u2014 the downgrade opportunity",
        "wpa3-mixed": "same as sae-mixed on some OpenWRT builds",
        "owe": "OWE only (Opportunistic Wireless Encryption)",
        "owe-transition": "Open BSS + hidden OWE BSS transition mode",
        "wpa2": "WPA2-Enterprise (802.1X) with CCMP",
        "wpa3": "WPA3-Enterprise",
        "wpa3-mixed-eap": "WPA2 + WPA3 enterprise transition"
      },
      "note": "These strings are what the UCI 'encryption' key accepts. sae-mixed / psk-mixed are the WPA3 / WPA2 transition-mode surfaces attackers watch for."
    }
  }
