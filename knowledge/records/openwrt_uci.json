  {
    "id": "uci-hostapd-disassoc-low-ack",
    "name": "hostapd disassoc_low_ack option",
    "category": "openwrt_uci",
    "region": "universal",
    "era_bounds": [
      "2015",
      null
    ],
    "still_effective_2026": true,
    "confidence": "primary",
    "citations": [
      "hostapd-docs"
    ],
    "technical_body": {
      "file": "/etc/hostapd/*.conf",
      "option": "disassoc_low_ack=1",
      "note": "AP disassociates clients whose ACK success rate falls below a threshold \u2014 used to shed hidden-node / dead clients. In an evil-twin context this option can cause premature disconnect if the attacker's link budget is worse than the legit AP's."
    }
  },
  {
    "id": "uci-hostapd-okc",
    "name": "hostapd okc option (Opportunistic Key Caching)",
    "category": "openwrt_uci",
    "region": "universal",
    "era_bounds": [
      "2014",
      null
    ],
    "still_effective_2026": true,
    "confidence": "primary",
    "citations": [
      "hostapd-docs"
    ],
    "technical_body": {
      "file": "/etc/hostapd/*.conf",
      "option": "okc=1",
      "note": "Enables Opportunistic Key Caching \u2014 PMKSA cache shared across APs sharing a WLC/RADIUS. Speeds roaming without needing 802.11r. Relevant to knowing whether a captured 4-way is real or an OKC cache hit that hashcat can't crack."
    }
  },
