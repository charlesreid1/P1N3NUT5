  {
    "id": "uci-hostapd-wpa-disable-eapol-key-retries",
    "name": "hostapd wpa_disable_eapol_key_retries",
    "category": "openwrt_uci",
    "region": "universal",
    "era_bounds": [
      "2017",
      null
    ],
    "still_effective_2026": true,
    "confidence": "primary",
    "citations": [
      "hostapd-docs",
      "vanhoef-krack-2017"
    ],
    "see_also": [
      "krack-key-reinstall"
    ],
    "technical_body": {
      "file": "/etc/hostapd/*.conf",
      "option": "wpa_disable_eapol_key_retries=1",
      "note": "KRACK mitigation. Disables retransmission of EAPOL-Key M3, which is what an MC-MitM replays to force nonce reuse on unpatched clients."
    }
  },
  {
    "id": "uci-hostapd-sae-pwe",
    "name": "hostapd sae_pwe",
    "category": "openwrt_uci",
    "region": "universal",
    "era_bounds": [
      "2020",
      null
    ],
    "still_effective_2026": true,
    "confidence": "primary",
    "citations": [
      "hostapd-docs",
      "vanhoef-dragonblood-2019"
    ],
    "technical_body": {
      "file": "/etc/hostapd/*.conf",
      "option": "sae_pwe=0|1|2",
      "note": "SAE Password Element derivation method. 0 = hunting-and-pecking only (Dragonblood-vulnerable), 1 = H2E (Hash-to-Element) only (Dragonblood-mitigated), 2 = both. WPA3 R3 clients should be H2E-only."
    }
  },
  {
    "id": "uci-hostapd-sae-groups",
    "name": "hostapd sae_groups",
    "category": "openwrt_uci",
    "region": "universal",
    "era_bounds": [
      "2018",
      null
    ],
    "still_effective_2026": true,
    "confidence": "primary",
    "citations": [
      "hostapd-docs"
    ],
    "technical_body": {
      "file": "/etc/hostapd/*.conf",
      "option": "sae_groups=19 20 21",
      "note": "Allowed SAE finite-cyclic-group IDs. 19 = P-256 (default, safe), 20 = P-384, 21 = P-521. Restricting to ECC groups blocks the Dragonblood MODP-downgrade path."
    }
  },
  {
    "id": "uci-hostapd-sae-require-mfp",
    "name": "hostapd sae_require_mfp",
    "category": "openwrt_uci",
    "region": "universal",
