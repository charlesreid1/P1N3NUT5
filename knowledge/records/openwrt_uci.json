    "still_effective_2026": true,
    "confidence": "primary",
    "citations": ["openwrt-uci-docs"],
    "technical_body": {
      "section": "wireless.<radio>",
      "options": {
        "type": "'mac80211' (default on Mark VII)",
        "channel": "int; 'auto' allowed",
        "hwmode": "'11g' | '11a' | '11na' | '11ng' | '11acg' | '11acna'",
        "htmode": "'HT20' | 'HT40+' | 'HT40-' | 'VHT80' | 'VHT160' | 'HE160' | 'EHT320'",
        "path": "'platform/...' bus path (identifies the radio)",
        "disabled": "0|1"
      },
      "example": "uci set wireless.radio0.channel=6; uci commit wireless; wifi reload"
    }
