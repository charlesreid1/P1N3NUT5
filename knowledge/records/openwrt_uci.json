    "id": "uci-hostapd-external",
    "name": "hostapd config outside UCI",
    "category": "openwrt_uci",
    "region": "universal",
    "era_bounds": [
      "2014",
      null
    ],
    "still_effective_2026": true,
    "confidence": "primary",
    "citations": [
      "hostapd-docs",
      "openwrt-uci-docs"
    ],
    "technical_body": {
      "path": "OpenWRT synthesizes /var/run/hostapd-phy0.conf from UCI on `wifi reload`",
      "override": "For attacks that need exotic hostapd knobs, write a standalone conf and run hostapd -B directly, bypassing UCI",
      "note": "This is how create_rogue_ap operates in the MCP \u2014 SCP a hostapd.conf, hostapd -B it under a named handle."
    }
  },
